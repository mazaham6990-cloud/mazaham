{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mazaham",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "78850ace-bd3b-43c4-922d-acbc8acece4c","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "8dca81aae7104141a68500c65b8e6a21" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
